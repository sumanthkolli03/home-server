# Copy to .env (never uploaded) and fill in. Docker Compose reads it automatically.
# A missing or empty value stops `docker compose up` with a message saying which one.

# Time zone for logs, e.g. America/New_York
TZ=UTC

# Your web addresses. PRIVATE: family-only sites. PUBLIC: everything anyone may open.
PRIVATE_DOMAIN=privateexample.com
PRIVATE_AUTH_DOMAIN=auth.privateexample.com
PUBLIC_DOMAIN=publicexample.net

# The public apps' services, written by the generator. Keep this line as it is.
COMPOSE_FILE=docker-compose.yml:generated/docker-compose.apps.yml
# Below this line the generator adds one <APP>_DOMAIN=<label>.PUBLIC_DOMAIN per app site, so no
# site name is ever in the repo. Values an app's app.toml reads as env:NAME go here too, by hand.

# copyparty trusts Caddy's "this user logged in" headers only when this secret header is present.
# Make one with:  echo "x-idp-$(openssl rand -hex 24)"
IDP_PROOF_HEADER=x-idp-CHANGE_ME

# Only if a Caddyfile has `email {$ACME_EMAIL}` (the address Let's Encrypt writes to)
# ACME_EMAIL=you@example.com

# Optional: the user and group the containers run as (default 1000)
# PUID=1000
# PGID=1000
